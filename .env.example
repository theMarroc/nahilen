# ---------------------------------------------------------------------------
# Nahilén — variables de entorno
# Copiá este archivo como `.env.local` y completá los valores.
# La app funciona SIN estas variables (muestra datos de demostración),
# pero para administrar el catálogo de verdad necesitás Supabase.
# ---------------------------------------------------------------------------

# Supabase → https://supabase.com/dashboard  (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role). NUNCA la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (sin barra final). En Vercel: https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago → https://www.mercadopago.com.ar/developers/panel
# Dejalas vacías si todavía no querés cobrar con Mercado Pago.
MP_ACCESS_TOKEN=
